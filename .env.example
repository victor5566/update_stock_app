PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change_me
PGDATABASE=stock_db
PORT=3000

# Used only by scripts/fill-cusip.js as the required contact info in the User-Agent header
# for SEC EDGAR requests (SEC blocks automated requests with no identifiable contact).
SEC_EDGAR_CONTACT=your-email@example.com

# Optional: schema holding the app's tables (default: the role's search_path, normally public)
# PGSCHEMA=test

# Optional: stock monitor daily run (HH:MM, server local time); rows per run for the slow lookups
# MONITOR_DAILY_AT=03:00
# MONITOR_DETAIL_LIMIT=300
# MONITOR_CUSIP_LIMIT=50
