#PUBLIC_URL=http://172.18.10.196:3000
#SEC_EDGAR_CONTACT=victorblacktea1@gmail.com

# Stock monitor: run an applying check every day at this local time (HH:MM). Remove to disable.
#MONITOR_DAILY_AT=03:00
