# Copy to .env and fill in. Save it as UTF-8 - a UTF-16 file (what Windows PowerShell 5.1's `>`
# writes) is read as no settings at all.

# The shared database (the app reads and writes test.company_profiles)
PGHOST=<db-host>
PGPORT=5432
PGUSER=<login role>
PGPASSWORD=<password>
PGDATABASE=waffle_test
# Required: the schema holding company_profiles (becomes the connection's search_path)
PGSCHEMA=test

PORT=3000
# Optional: address to listen on (default 0.0.0.0 = all interfaces)
# HOST=0.0.0.0

# Required contact info for the User-Agent header of SEC EDGAR requests (SEC blocks automated
# requests without one). Used by every CUSIP lookup: adds, the stock monitor, scripts/fill-cusip.js.
SEC_EDGAR_CONTACT=your-email@example.com

# Optional: stock monitor daily run (HH:MM, in the server's time zone - APP_TZ when deployed with
# deploy/); rows per run for the slow lookups
# MONITOR_DAILY_AT=03:00
# MONITOR_DETAIL_LIMIT=300
# MONITOR_CUSIP_LIMIT=50

# ---------------------------------------------------------------------------------------------
# Reference: the settings actually in use (commented out). Passwords are not kept here - this
# file is committed; put the real ones only in your .env.

# Remote database (app connects here)
#PGHOST=37.61.216.26
#PGPORT=5432
#PGUSER=victor
#PGPASSWORD=<password>
#PGDATABASE=waffle_test
