# Copy to .env and fill in. Save it as UTF-8 - a UTF-16 file (what Windows PowerShell 5.1's `>`
# writes) is read as no settings at all.

# (MONITOR_DAILY_AT / MONITOR_CUSIP_LIMIT are gone: the stock monitor's applying run and daily
# schedule were removed on 2026-10-16 - the monitor only previews now.)

# ---------------------------------------------------------------------------------------------
# Reference: the settings actually in use (commented out). Passwords are not kept here - this
# file is committed; put the real ones only in your .env.

# Remote database (app connects here)
PGHOST=37.61.216.26
PGPORT=5432
PGUSER=victor
PGPASSWORD=TryBetter0&
PGDATABASE=waffle
PGSCHEMA=test


PORT=3000
# Address to listen on (0.0.0.0 = all interfaces) and the site address the frontend JavaScript uses for API calls
HOST=0.0.0.0
PUBLIC_URL=http://172.18.10.196:3000
SEC_EDGAR_CONTACT=victorblacktea1@gmail.com
# Login (lib/auth.js): signs the session cookie - any long random string, e.g. `openssl rand -hex 32`.
# Unset = a random one per start, so every restart logs everyone out.
SESSION_SECRET=
# The session cookie is marked Secure (https only) when the request came over https (behind
# nginx: its X-Forwarded-Proto); true = always
COOKIE_SECURE=false
# Proxies whose X-Forwarded-For / -Proto are trusted (Express 'trust proxy'); default
# "loopback, linklocal, uniquelocal" = a proxy on a private address (nginx -> LXC); false = none
# TRUST_PROXY=
# true = log in by email alone (still only role LABEL + status true), no password - for trying it out only
LOGIN_EMAIL_ONLY=false
